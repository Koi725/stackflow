// Stackflow backend schema.
// Enum values are the exact lowercase strings the frontend uses in
// frontend/lib/types.ts, so they serialize straight to JSON with no mapping.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  name         String
  initials     String
  email        String  @unique
  // Nullable: users mirrored from an external auth provider (AUTH_MODE=darsman)
  // never have a stackflow password — identity is verified upstream. Local
  // (AUTH_MODE=local) users always have a bcrypt hash here.
  passwordHash String?
  role         Role    @default(member)
  // Optional profile fields the user edits themselves via /api/profile.
  // avatarUrl points at our own /api/avatar/<uuid> serving route (never a remote URL).
  avatarUrl    String?
  firstName    String?
  lastName     String?
  age          Int?
  cards        Card[]
}

model Card {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  label       Label
  priority    Priority
  column      Column   @default(todo)
  // ownerId is the assignee — the user the card is assigned to. Admins may
  // reassign it (set it to anyone); members can only own their own cards.
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  // A member can raise a hand for help on their own card; admins can see it.
  needsHelp   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum Role {
  admin
  member
}

enum Label {
  bug
  feature
  docs
}

enum Priority {
  high
  med
  low
}

enum Column {
  todo
  progress
  blocked
  done
}
