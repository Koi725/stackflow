# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/stackflow?schema=public"

# Authentication mode. "local" (default) checks stackflow's own User table with
# bcrypt — the normal, public path. "darsman" delegates credential checks to an
# external login API (private deployments only); leave it as local otherwise.
AUTH_MODE="local"

# External auth endpoint, used ONLY when AUTH_MODE=darsman. Blank/commented for
# the public build. It receives POST {email, password} and returns the user's
# profile (name, role); stackflow stores no password for these users.
# DARSMAN_AUTH_URL=""

# Secret used to sign session JWTs. MUST be at least 32 characters of strong
# randomness. Generate one with:
#   openssl rand -hex 32
# The app refuses to start if this is unset, too short, or left as a placeholder.
SESSION_SECRET=""

# Passwords for the seeded accounts (prisma db seed). No defaults — required to seed.
SEED_ADMIN_PASSWORD="change-me-admin"
SEED_MEMBER_PASSWORD="change-me-member"

# Where uploaded avatar files are stored on disk. Optional — defaults to
# ./var/avatars (gitignored). Must be OUTSIDE ./public so files are only served
# through the hardened /api/avatar route (verified Content-Type + nosniff).
# AVATAR_UPLOAD_DIR="./var/avatars"
