# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/stackflow?schema=public"

# Secret used to sign session JWTs. Generate a long random value, e.g.:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Passwords for the seeded accounts (prisma db seed). No defaults — required to seed.
SEED_ADMIN_PASSWORD="change-me-admin"
SEED_MEMBER_PASSWORD="change-me-member"
