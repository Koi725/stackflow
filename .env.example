# Root .env for the Docker/Compose production deploy. Copy to .env and fill in.
# .env is gitignored — never commit real secrets. (For non-Docker local dev, see
# frontend/.env.example instead.)

# --- PostgreSQL (the `db` service) ---
POSTGRES_USER="stackflow"
POSTGRES_PASSWORD="change-me-strong-db-password"
POSTGRES_DB="stackflow"

# --- App database connection ---
# Host is the compose service name `db`. User/password/db MUST match POSTGRES_* above.
DATABASE_URL="postgresql://stackflow:change-me-strong-db-password@db:5432/stackflow?schema=public"

# --- Session signing secret (required) ---
# Generate a long random value, e.g.:  openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Authentication mode ---
# "local" (default) verifies users against Stackflow's own table with bcrypt.
# "darsman" delegates credential checks to the external darsman backend (private
# deployments only). This deployment runs darsman — set it here.
AUTH_MODE="darsman"
# External auth endpoint, used ONLY when AUTH_MODE=darsman.
#
# The app container joins the darsman stack's Docker network (see the `darsman`
# external network in docker-compose.yml), so it reaches the backend by CONTAINER
# NAME on the container's OWN port 8000 — NOT via host.docker.internal, NOT via
# 127.0.0.1/the host-published 127.0.0.1:8300 (that port is only reachable from
# the host, not from inside this container).
#
# Container name defaults to "<project>-<service>-N" → "darsman-backend-1".
# VERIFY on the server with `docker ps` and adjust the host below if it differs.
DARSMAN_AUTH_URL="http://darsman-backend-1:8000/api/auth/login"

# --- Seed account passwords (used only by the manual `prisma db seed` step) ---
SEED_ADMIN_PASSWORD="change-me-admin"
SEED_MEMBER_PASSWORD="change-me-member"

# --- Avatar uploads ---
# Persistent path INSIDE the container; must match the `avatars` volume mount in
# docker-compose.yml so uploaded avatars survive rebuilds/redeploys.
AVATAR_UPLOAD_DIR="/app/var/avatars"
